# =============================================================================
# Arène des Gamers — .htaccess racine du domaine
# =============================================================================
# Structure : <docroot>/.htaccess  +  <docroot>/arene-page/public/index.php
#
# ⚠️ Alternative recommandée : pointer le document root du domaine sur
#    « arene-page/public » puis supprimer ce fichier.
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # -----------------------------------------------------------------------
    # 1. Refuser secrets et sources
    # -----------------------------------------------------------------------
    RewriteRule (^|/)\.env(\..*)?$ - [F,L]
    RewriteRule (^|/)\.git(/|$) - [F,L]
    RewriteRule ^arene-page/(app|bootstrap|config|database|node_modules|resources|routes|storage|tests|vendor)(/|$) - [F,L]
    RewriteRule ^arene-page/(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|\.htaccess)$ - [F,L]

    # -----------------------------------------------------------------------
    # 2. Tout fichier réellement présent dans arene-page/public/ est servi
    #    directement. Couvre : build/, img/, uploads/, favicon.ico.
    # -----------------------------------------------------------------------
    RewriteCond %{DOCUMENT_ROOT}/arene-page/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ arene-page/public/$1 [L]

    # Répertoires publics (ex. /build/assets/)
    RewriteCond %{DOCUMENT_ROOT}/arene-page/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ arene-page/public/$1 [L]

    # -----------------------------------------------------------------------
    # 3. Tout le reste -> front controller Laravel
    # -----------------------------------------------------------------------
    RewriteRule ^ arene-page/public/index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Pas de « Options -Indexes » : souvent interdit par AllowOverride (=> 500).