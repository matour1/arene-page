# =============================================================================
# Arène des Gamers — redirection de toute la racine vers public/
# =============================================================================
# Ce fichier n'agit QUE si l'hébergeur impose la racine du projet comme
# document root (cas fréquent en mutualisé LWS).
#
#   /                    -> public/index.php  (Laravel)
#   /build/app-xxx.css   -> public/build/app-xxx.css
#   /uploads/...         -> public/uploads/...
#   /img/...             -> public/img/...
#   /.env, /vendor/...   -> 403
#
# Si le domaine pointe directement sur public/, ce fichier n'est jamais lu.
# =============================================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- 1. Secrets et fichiers de développement : refus net ----------------
    RewriteRule ^\.env(\..*)?$                  - [F,L]
    RewriteRule ^\.git(/|$)                     - [F,L]
    RewriteRule ^composer\.(json|lock)$         - [F,L]
    RewriteRule ^package(-lock)?\.json$         - [F,L]
    RewriteRule ^artisan$                       - [F,L]
    RewriteRule ^phpunit\.xml$                  - [F,L]
    RewriteRule ^(app|bootstrap|config|database|node_modules|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # --- 2. Assets servis depuis public/ -----------------------------------
    RewriteRule ^(build|uploads|img)/(.*)$      public/$1/$2 [L]
    RewriteRule ^favicon\.ico$                  public/favicon.ico [L]

    # --- 3. Tout le reste vers le front controller -------------------------

    # Un fichier ou dossier existant dans public/ est servi directement.
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^ - [L]

    # Sinon : Laravel traite la requête (routes, robots.txt, sitemap.xml…).
    RewriteRule ^ public/index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # À décommenter une fois le HTTPS confirmé sur tout le domaine.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>