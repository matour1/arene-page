# =============================================================================
# Arène des Gamers — .htaccess de la racine du domaine
# =============================================================================
#
# Gère automatiquement DEUX structures, sans modification :
#
#   A) projet à la racine
#      <docroot>/public/index.php
#
#   B) projet dans un sous-dossier (cas actuel)
#      <docroot>/arene-page/public/index.php
#
# Le préfixe est détecté par RewriteCond, puis réutilisé dans les règles.
#
# ⚠️ Alternative recommandée : pointer le document root du domaine sur
#    « arene-page/public ». Ce fichier devient alors inutile.
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- 1. Déterminer le préfixe du projet -------------------------------
    # Si <docroot>/public/index.php existe → préfixe vide (structure A).
    # Sinon → arene-page/ (structure B).
    RewriteCond %{DOCUMENT_ROOT}/public/index.php -f
    RewriteRule ^ - [E=PREFIXE:]

    RewriteCond %{DOCUMENT_ROOT}/public/index.php !-f
    RewriteRule ^ - [E=PREFIXE:arene-page/]

    # --- 2. Refuser les secrets et les sources ----------------------------
    RewriteRule ^(.+/)?\.env(\..*)?$ - [F,L]
    RewriteRule ^(.+/)?\.git(/|$) - [F,L]
    RewriteRule ^(.+/)?(app|bootstrap|config|database|node_modules|resources|routes|storage|tests|vendor)(/|$) - [F,L]
    RewriteRule ^(.+/)?(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$ - [F,L]

    # --- 3. Assets présents dans public/ → servis directement -------------
    RewriteCond %{DOCUMENT_ROOT}/%{ENV:PREFIXE}public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ %{ENV:PREFIXE}public/$1 [L]

    # --- 4. Tout le reste → front controller Laravel ----------------------
    RewriteRule ^ %{ENV:PREFIXE}public/index.php [L]
</IfModule>

# -----------------------------------------------------------------------------
# En-têtes de sécurité (silencieusement ignorés sans mod_headers)
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Volontairement pas de « Options -Indexes » : cette directive est souvent
# interdite par AllowOverride chez les mutualisés et provoque un 500.