APP_NAME="Arene des Gamers"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lecoindesgameur.gamehub-arena.com/
APP_TIMEZONE=Africa/Douala

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Neon (PostgreSQL serverless) ---
# pdo_pgsql doit etre active cote hebergeur.
DB_CONNECTION=pgsql
DB_HOST=ep-xxxxxxx.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=
DB_PASSWORD=
# SSL obligatoire sur Neon : ne jamais passer a 'prefer' ni 'disable'.
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@votre-domaine.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- GameHub Arena API ---
GAMEHUB_BASE_URL=https://api.gamehub-arena.com/api/v1
GAMEHUB_TOKEN=
GAMEHUB_TIMEOUT=15
# 60 min = 24 executions/jour, ~720 requetes/mois (quota gratuit : 1000).
GAMEHUB_SYNC_MINUTES=60
GAMEHUB_SYNC_PAGES_MAX=2

# --- Affiliation ---
GAMEHUB_AFFILIATE_URL=
GAMEHUB_COMMISSION_GLOBALE=5
GAMEHUB_COMMISSION_TOURNOI=2

# --- Back-office (chemin non devinable) ---
ARENE_ADMIN_PATH=

# --- SEO ---
ARENE_SEO_SUFFIXE="Tournois e-sport, LFT et guides gaming"
ARENE_SEO_DESCRIPTION="Calendrier des tournois e-sport mobiles d'Afrique centrale et de l'Ouest, matchmaking LFT et guides pour progresser."
# Verification Search Console / Bing (optionnel)
ARENE_SEO_GOOGLE=
ARENE_SEO_BING=
# Compte Twitter/X pour la Twitter Card (optionnel, format @compte)
ARENE_SEO_TWITTER=

# --- Communaute ---
ARENE_DISCORD_URL=
ARENE_WHATSAPP_URL=https://chat.whatsapp.com/Ij9AdHcAGyqC1SoBOhXpTe

# --- Regie publicitaire (alternative a AdSense) ---
ARENE_PUB_ACTIF=false
ARENE_PUB_SCRIPT=
ARENE_PUB_IMAGE=
ARENE_PUB_URL=
ARENE_PUB_ALT=Publicite

VITE_APP_NAME="${APP_NAME}"
# --- Site public GameHub Arena (repli si aucun lien de parrainage) ---
GAMEHUB_SITE_URL=https://gamehub-arena.com
